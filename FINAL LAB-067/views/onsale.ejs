<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>On Sale Products - Sania Maskatiya</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f7f7f7;
            color: #333;
        }

        .page-header {
            padding: 30px 20px;
            text-align: center;
            background: #fff;
            box-shadow: 0 1px 6px rgba(0,0,0,0.05);
            margin-bottom: 20px;
        }

        .page-header h1 {
            font-size: 2.5rem;
            letter-spacing: 2px;
            color: #8b4789;
            margin-bottom: 10px;
        }

        .page-header p {
            color: #666;
            font-size: 1rem;
            max-width: 720px;
            margin: 0 auto;
        }

        .container {
            max-width: 1180px;
            margin: 0 auto;
            padding: 20px;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }

        .product-card {
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 6px 22px rgba(0,0,0,0.07);
            display: flex;
            flex-direction: column;
        }

        .product-image {
            width: 100%;
            height: 260px;
            object-fit: cover;
            background: #f6f6f6;
        }

        .product-info {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex: 1;
        }

        .product-category { font-size: 0.78rem; color: #8b4789; text-transform: uppercase; letter-spacing: 1px; }
        .product-name { font-size: 1.2rem; line-height: 1.2; font-weight: 700; color: #202020; }
        .product-price { color: #8b4789; font-weight: 700; font-size: 1.1rem; }
        .product-stock { font-size: 0.9rem; }
        .stock-available { color: #27ae60; }
        .stock-unavailable { color: #c0392b; }

        #pagination-controls { display:flex; justify-content:center; gap:12px; align-items:center; margin:24px 0; }
        #pagination-controls button[disabled] { opacity:0.5; cursor:not-allowed; }
        /* Button styles copied from shop-by.ejs to ensure visual parity */
        .btn {
            padding: 12px 20px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-weight: 700;
            transition: all 0.25s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-primary, .btn-apply {
            background: #000;
            color: #fff;
            border: 1px solid #000;
            border-radius: 20px;
            padding: 10px 18px;
        }

        .btn-primary:hover, .btn-apply:hover {
            background: #111;
            color: #fff;
            transform: translateY(-1px);
        }

        .btn-secondary, .btn-clear {
            background: transparent;
            color: #000;
            border: 1px solid #ddd;
            border-radius: 20px;
            padding: 10px 18px;
        }

        .btn-secondary:hover, .btn-clear:hover {
            background: #000;
            color: #fff;
            border-color: #000;
        }

        .btn-small {
            flex: 1;
            padding: 11px 14px;
            border-radius: 10px;
            font-size: 0.92rem;
        }
    </style>
</head>
<body>
    <div class="top-bar">PROMOTIONS - ON SALE PRODUCTS</div>

    <header class="main-header">
        <div class="logo">
            <img src="/images/logo.svg" alt="Sania Maskatiya">
        </div>

        <button class="hamburger-menu" id="hamburgerMenu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav class="nav-menu" id="navMenu">
            <ul>
                <li><a href="/">Homepage</a></li>
                <li><a href="/unstitched-lawn">UNSTITCHED LAWN '26</a></li>
                <li><a href="/shop-by">SHOP BY</a></li>
                <li><a href="/luxe-pret">LUXE PRET</a></li>
                <li><a href="/formals">FORMALS</a></li>
                <li><a href="/bridals">BRIDALS</a></li>
                <li><a href="/contact-us">Contact Us</a></li>
                <% if (user) { %>
                    <li><a href="/profile">My Profile</a></li>
                    <li><a href="/orders">My Orders</a></li>
                    <li><a href="/logout">Logout</a></li>
                    <% if (user.role === 'admin') { %>
                        <li><a href="/admin">Admin Panel</a></li>
                    <% } %>
                <% } else { %>
                    <li><a href="/login">Login</a></li>
                    <li><a href="/register">Register</a></li>
                <% } %>
            </ul>
        </nav>

        <div class="header-icons"></div>
    </header>

    <main class="container" style="padding:24px 20px;">
        <h1>On-Sale Products</h1>
        <p>All promotional items are shown below. Use the controls to browse in groups of 10.</p>

        <% if (products && products.length > 0) { %>
            <div id="product-list" class="products-grid">
                <% products.forEach(function(product){ %>
                    <div class="product-card" data-id="<%= product._id %>">
                        <img src="<%= product.image || '/images/placeholder.svg' %>" alt="<%= product.name %>" class="product-image" onerror="this.onerror=null;this.src='/images/placeholder.svg'">
                        <div class="product-info">
                            <div class="product-category"><%= product.category %></div>
                            <div class="product-name"><%= product.name %></div>
                            <div class="product-price">Rs. <%= product.price.toLocaleString() %></div>
                            <div class="product-stock <%= product.stock > 0 ? 'stock-available' : 'stock-unavailable' %>">
                                <%= product.stock > 0 ? `In Stock (${product.stock})` : 'Out of Stock' %>
                            </div>
                            <div style="margin-top:8px; display:flex; gap:8px;">
                                <form method="get" action="/order/confirm" style="display:flex;gap:8px;align-items:center">
                                    <input type="hidden" name="productId" value="<%= product._id %>">
                                    <input type="number" name="qty" value="1" min="1" max="<%= product.stock %>" style="width:70px;padding:6px;border:1px solid #ddd;border-radius:4px">
                                    <button class="btn btn-primary btn-small" type="submit" <%= product.stock === 0 ? 'disabled' : '' %>>Order Now</button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>

            <div id="pagination-controls">
                <button id="prev-btn">← Previous</button>
                <span id="page-indicator">Page 1 of 1</span>
                <button id="next-btn">Next →</button>
            </div>
        <% } else { %>
            <div class="no-products">
                <h2>No promotional items found</h2>
                <p>Check back later or explore other categories.</p>
            </div>
        <% } %>
    </main>

    <!-- jQuery (for the onsale pagination logic) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/js/script.js"></script>
    <script>
        // jQuery-only pagination: show 10 items per page from the pre-rendered DOM
        $(function () {
            const $cards = $('#product-list .product-card');
            const perPage = 10;
            let currentPage = 1;
            const totalItems = $cards.length;
            const totalPages = Math.max(1, Math.ceil(totalItems / perPage));

            function showPage(page) {
                currentPage = page;
                $cards.hide();
                const start = (page - 1) * perPage;
                $cards.slice(start, start + perPage).show();
                $('#page-indicator').text('Page ' + currentPage + ' of ' + totalPages);
                if (currentPage <= 1) { $('#prev-btn').attr('disabled', true); } else { $('#prev-btn').attr('disabled', false); }
                if (currentPage >= totalPages) { $('#next-btn').attr('disabled', true); } else { $('#next-btn').attr('disabled', false); }
            }

            // Initialize
            if (totalItems === 0) return;
            // Hide all then show first page
            $cards.hide();
            showPage(1);

            $('#next-btn').on('click', function () {
                if (currentPage < totalPages) showPage(currentPage + 1);
            });
            $('#prev-btn').on('click', function () {
                if (currentPage > 1) showPage(currentPage - 1);
            });
        });
    </script>
</body>
</html>
