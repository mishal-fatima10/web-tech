<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Orders - Sania Maskatiya Store</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Montserrat', sans-serif; background-color: #f7f7f7; color: #333; }
    .top-bar { background: #8b4789; color: white; text-align: center; padding: 10px; font-size: 0.9rem; }
    .page-header { padding: 30px 20px; text-align: center; background: white; box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-bottom: 30px; }
    .page-header h1 { font-size: 2rem; color: #8b4789; margin: 0; }
    .container { max-width: 1000px; margin: 0 auto; padding: 20px; }
    .nav-links { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
    .nav-links a { padding: 10px 16px; background: #8b4789; color: white; text-decoration: none; border-radius: 6px; font-weight: 600; transition: background 0.3s; }
    .nav-links a:hover { background: #6d5845; }
    .nav-links a.secondary { background: #ddd; color: #333; }
    .nav-links a.secondary:hover { background: #bbb; }
    .empty-state { text-align: center; padding: 60px 20px; background: white; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
    .empty-state h2 { color: #8b4789; font-size: 1.5rem; margin-bottom: 10px; }
    .empty-state a { display: inline-block; margin-top: 20px; padding: 12px 24px; background: #8b4789; color: white; text-decoration: none; border-radius: 6px; font-weight: 600; }
    .empty-state a:hover { background: #6d5845; }
    .order-card { background: white; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-bottom: 20px; overflow: hidden; transition: transform 0.3s, box-shadow 0.3s; }
    .order-card:hover { transform: translateY(-4px); box-shadow: 0 4px 16px rgba(0,0,0,0.12); }
    .order-header { padding: 20px; background: linear-gradient(135deg, #8b4789 0%, #6d5845 100%); color: white; display: flex; justify-content: space-between; align-items: center; }
    .order-id { font-weight: 700; font-size: 1.1rem; }
    .order-date { font-size: 0.9rem; opacity: 0.9; }
    .order-meta { display: flex; gap: 20px; font-size: 0.95rem; }
    .order-items { padding: 20px; border-bottom: 1px solid #f0f0f0; }
    .item-list { display: flex; flex-direction: column; gap: 12px; }
    .item { display: flex; gap: 12px; }
    .item-img { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; }
    .item-info { flex: 1; }
    .item-name { font-weight: 700; color: #333; margin-bottom: 4px; }
    .item-detail { font-size: 0.9rem; color: #666; }
    .order-footer { padding: 20px; display: flex; justify-content: space-between; align-items: center; }
    .order-total { display: flex; flex-direction: column; align-items: flex-end; }
    .order-total-label { font-size: 0.9rem; color: #666; }
    .order-total-amount { font-size: 1.5rem; font-weight: 700; color: #8b4789; }
    .status-badge { display: inline-block; padding: 6px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; }
    .status-badge.pending { background: #fff3cd; color: #856404; }
    .status-badge.processing { background: #d1ecf1; color: #0c5460; }
    .status-badge.completed { background: #d4edda; color: #155724; }
    .status-badge.cancelled { background: #f8d7da; color: #721c24; }
    .payment-badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 600; background: #f0f0f0; color: #333; }
  </style>
</head>
<body>
  <div class="top-bar">MY ORDERS</div>

  <header class="main-header">
    <div class="logo"><img src="/images/logo.svg" alt="Sania Maskatiya"></div>
    <button class="hamburger-menu" id="hamburgerMenu">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav-menu" id="navMenu">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/shop-by">Shop</a></li>
        <li><a href="/profile">Profile</a></li>
        <li><a href="/logout">Logout</a></li>
      </ul>
    </nav>
  </header>

  <div class="page-header">
    <h1>My Orders</h1>
  </div>

  <div class="container">
    <div class="nav-links">
      <a href="/profile">← Back to Profile</a>
      <a href="/shop-by" class="secondary">Continue Shopping</a>
    </div>

    <% if (orders.length === 0) { %>
      <div class="empty-state">
        <h2>No Orders Yet</h2>
        <p>You haven't placed any orders yet. Start shopping now to place your first order!</p>
        <a href="/shop-by">Browse Products</a>
      </div>
    <% } else { %>
      <% orders.forEach(function(order, index){ %>
        <div class="order-card">
          <div class="order-header">
            <div>
              <div class="order-id">Order #<%= (index + 1) %></div>
              <div class="order-date"><%= new Date(order.createdAt).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></div>
            </div>
            <div class="order-meta">
              <span class="status-badge <%= order.status %>"><%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %></span>
              <span class="payment-badge"><%= order.paymentMethod.toUpperCase() %></span>
            </div>
          </div>

          <div class="order-items">
            <div class="item-list">
              <% order.items.forEach(function(it){ %>
                <div class="item">
                  <img src="<%= it.product.image %>" alt="<%= it.product.name %>" class="item-img">
                  <div class="item-info">
                    <div class="item-name"><%= it.product.name %></div>
                    <div class="item-detail">Category: <%= it.product.category %></div>
                    <div class="item-detail">Unit Price: Rs. <%= it.product.price.toLocaleString() %></div>
                    <div class="item-detail">Quantity: <%= it.quantity %></div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <div class="order-footer">
            <div>Order placed on <%= new Date(order.createdAt).toLocaleString() %></div>
            <div class="order-total">
              <div class="order-total-label">Order Total</div>
              <div class="order-total-amount">Rs. <%= order.totalPrice.toLocaleString() %></div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <script src="/js/script.js"></script>
</body>
</html>
