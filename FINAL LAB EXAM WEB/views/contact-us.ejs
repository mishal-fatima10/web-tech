<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f7f7f7;
            color: #333;
        }

        .contact-hero {
            padding: 30px 20px;
            text-align: center;
            background: #fff;
            box-shadow: 0 1px 6px rgba(0,0,0,0.05);
            margin-bottom: 20px;
        }

        .contact-hero h1 {
            font-size: 2.4rem;
            letter-spacing: 2px;
            color: #8b4789;
            margin-bottom: 10px;
        }

        .contact-hero p {
            color: #666;
            font-size: 1rem;
            max-width: 720px;
            margin: 0 auto;
        }

        .container {
            max-width: 1180px;
            margin: 0 auto;
            padding: 20px;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .contact-card {
            background: #fff;
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 6px 22px rgba(0,0,0,0.07);
        }

        .contact-card h3 {
            color: #202020;
            margin-bottom: 10px;
        }

        .contact-card p {
            color: #666;
            line-height: 1.5;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 20px;
        }

        .product-card {
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 6px 22px rgba(0,0,0,0.07);
            display: flex;
            flex-direction: column;
        }

        .product-image {
            width: 100%;
            height: 240px;
            object-fit: cover;
            background: #f6f6f6;
        }

        .product-info {
            padding: 18px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .product-category {
            font-size: 0.78rem;
            color: #8b4789;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .product-name {
            font-size: 1.05rem;
            line-height: 1.2;
            font-weight: 700;
            color: #202020;
        }

        .product-price {
            color: #8b4789;
            font-weight: 700;
            font-size: 1rem;
        }

        .section-title {
            font-size: 1.35rem;
            margin: 30px 0 16px;
            color: #202020;
        }
    </style>
</head>
<body>

    <div class="top-bar">
        CONTACT US - SANIA MASKATIYA STORE
    </div>

    <header class="main-header">
        <div class="logo">
            <img src="/images/logo.svg" alt="Sania Maskatiya">
        </div>

        <button class="hamburger-menu" id="hamburgerMenu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav class="nav-menu" id="navMenu">
            <ul>
                <li><a href="/">Homepage</a></li>
                <li><a href="/unstitched-lawn">UNSTITCHED LAWN '26</a></li>
                <li><a href="/shop-by">SHOP BY</a></li>
                <li><a href="/onsale-products">ON SALE</a></li>
                <li><a href="/luxe-pret">LUXE PRET</a></li>
                                <li><a href="/formals">FORMALS</a></li>
                <li><a href="/bridals">BRIDALS</a></li>
                                <li><a href="/contact-us">Contact Us</a></li>
            </ul>
        </nav>

        <div class="header-icons">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        </div>
    </header>

    <main>
        <div class="contact-hero">
            <h1>Contact Us</h1>
            <p>We are here to help with styling guidance, order updates, and custom bridal appointments.</p>
        </div>

        <div class="container">
            <div class="contact-grid">
                <div class="contact-card">
                    <h3>Studio Address</h3>
                    <p>88-A, Main Boulevard<br>Gulberg, Lahore, Pakistan</p>
                </div>
                <div class="contact-card">
                    <h3>Client Care</h3>
                    <p>Phone: +92 300 123 4567<br>Email: hello@saniamaskatiya.com</p>
                </div>
                <div class="contact-card">
                    <h3>Working Hours</h3>
                    <p>Mon - Sat: 11:00 AM - 8:00 PM<br>Sunday: Closed</p>
                </div>
                <div class="contact-card">
                    <h3>Bridal Appointments</h3>
                    <p>Request a consultation for bridals, formals, and bespoke fittings.</p>
                </div>
            </div>

            <h2 class="section-title">Featured Products</h2>
            <% if (featuredProducts && featuredProducts.length > 0) { %>
                <div class="products-grid">
                    <% featuredProducts.forEach(product => { %>
                        <div class="product-card">
                            <img src="<%= product.image || '/images/placeholder.svg' %>" alt="<%= product.name %>" class="product-image" onerror="this.onerror=null;this.src='/images/placeholder.svg'">
                            <div class="product-info">
                                <div class="product-category"><%= product.category %></div>
                                <div class="product-name"><%= product.name %></div>
                                <div class="product-price">Rs. <%= product.price.toLocaleString() %></div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <p>No featured products available right now. Please check back soon.</p>
            <% } %>
        </div>
    </main>

    <script src="/js/script.js"></script>
</body>
</html>