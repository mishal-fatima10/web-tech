<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> - Sania Maskatiya</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f7f7f7;
            color: #333;
        }

        .page-header {
            padding: 30px 20px;
            text-align: center;
            background: #fff;
            box-shadow: 0 1px 6px rgba(0,0,0,0.05);
            margin-bottom: 20px;
        }

        .page-header h1 {
            font-size: 2.4rem;
            letter-spacing: 2px;
            color: #8b4789;
            margin-bottom: 10px;
        }

        .page-header p {
            color: #666;
            font-size: 1rem;
            max-width: 720px;
            margin: 0 auto;
        }

        .container {
            max-width: 1180px;
            margin: 0 auto;
            padding: 20px;
        }

        .products-info {
            margin-bottom: 16px;
            font-size: 0.95rem;
            color: #555;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }

        .product-card {
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 6px 22px rgba(0,0,0,0.07);
            display: flex;
            flex-direction: column;
        }

        .product-image {
            width: 100%;
            height: 260px;
            object-fit: cover;
            background: #f6f6f6;
        }

        .product-info {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex: 1;
        }

        .product-category {
            font-size: 0.78rem;
            color: #8b4789;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .product-name {
            font-size: 1.2rem;
            line-height: 1.2;
            font-weight: 700;
            color: #202020;
        }

        .product-price {
            color: #8b4789;
            font-weight: 700;
            font-size: 1.1rem;
        }

        .product-rating {
            color: #f39c12;
            font-size: 0.95rem;
        }

        .product-stock {
            font-size: 0.9rem;
        }

        .stock-available {
            color: #27ae60;
        }

        .stock-unavailable {
            color: #c0392b;
        }

        .product-actions {
            margin-top: auto;
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        .btn {
            padding: 12px 20px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-weight: 700;
            transition: all 0.25s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-primary {
            background: #000;
            color: #fff;
            border: 1px solid #000;
            border-radius: 20px;
            padding: 10px 18px;
        }

        .btn-primary:hover {
            background: #111;
            color: #fff;
            transform: translateY(-1px);
        }

        .btn-small {
            flex: 1;
            padding: 11px 14px;
            border-radius: 10px;
            font-size: 0.92rem;
        }

        .no-products {
            grid-column: 1 / -1;
            text-align: center;
            padding: 50px 20px;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 6px 22px rgba(0,0,0,0.04);
        }

        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 30px;
        }

        .pagination a,
        .pagination span {
            padding: 10px 14px;
            border: 1px solid #ddd;
            border-radius: 8px;
            color: #333;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .pagination a:hover {
            background: #8b4789;
            color: #fff;
            border-color: #8b4789;
        }

        .pagination .active {
            background-color: #8b4789;
            color: white;
            border-color: #8b4789;
        }

        .pagination .disabled {
            color: #aaa;
            cursor: default;
            border-color: #eee;
        }

        @media (max-width: 768px) {
            .products-grid {
                grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            }
        }
    </style>
</head>
<body>
    <div class="top-bar"><%= topBarText %></div>

    <header class="main-header">
        <div class="logo">
            <img src="/images/logo.svg" alt="Sania Maskatiya">
        </div>

        <button class="hamburger-menu" id="hamburgerMenu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav class="nav-menu" id="navMenu">
            <ul>
                <li><a href="/">Homepage</a></li>
                <li><a href="/unstitched-lawn">UNSTITCHED LAWN '26</a></li>
                <li><a href="/shop-by">SHOP BY</a></li>
                <li><a href="/onsale-products">ON SALE</a></li>
                <li><a href="/luxe-pret">LUXE PRET</a></li>
                <li><a href="/formals">FORMALS</a></li>
                <li><a href="/bridals">BRIDALS</a></li>
                <li><a href="/contact-us">Contact Us</a></li>
                <% if (user) { %>
                    <li><a href="/profile">My Profile</a></li>
                    <li><a href="/orders">My Orders</a></li>
                    <li><a href="/logout">Logout</a></li>
                    <% if (user.role === 'admin') { %>
                        <li><a href="/admin">Admin Panel</a></li>
                    <% } %>
                <% } else { %>
                    <li><a href="/login">Login</a></li>
                    <li><a href="/register">Register</a></li>
                <% } %>
            </ul>
        </nav>

        <div class="header-icons"></div>
    </header>

    <div class="page-header">
        <h1><%= pageTitle %></h1>
        <p>Discover the latest drops in <%= categoryName %> with 8 pieces per page.</p>
    </div>

    <div class="container">
        <div class="products-info">
            Showing <strong><%= products.length %></strong> of <strong><%= totalProducts %></strong> products in <strong><%= categoryName %></strong>
        </div>

        <% if (products.length > 0) { %>
            <div class="products-grid">
                <% products.forEach(product => { %>
                    <div class="product-card">
                        <img src="<%= product.image || '/images/placeholder.svg' %>" alt="<%= product.name %>" class="product-image" onerror="this.onerror=null;this.src='/images/placeholder.svg'">
                        <div class="product-info">
                            <div class="product-category"><%= product.category %></div>
                            <div class="product-name"><%= product.name %></div>
                            <div class="product-price">Rs. <%= product.price.toLocaleString() %></div>
                            <div class="product-rating">
                                <% for (let i = 0; i < Math.round(product.rating); i++) { %>★<% } %>
                                <% for (let i = Math.round(product.rating); i < 5; i++) { %>☆<% } %>
                                (<%= product.rating.toFixed(1) %>)
                            </div>
                            <div class="product-stock <%= product.stock > 0 ? 'stock-available' : 'stock-unavailable' %>">
                                <%= product.stock > 0 ? `In Stock (${product.stock} available)` : 'Out of Stock' %>
                            </div>
                            <% if (product.description) { %>
                                <p style="font-size: 0.95rem; color: #555;"><%= product.description.substring(0, 80) %><%= product.description.length > 80 ? '...' : '' %></p>
                            <% } %>
                            <div class="product-actions">
                                <form method="get" action="/order/confirm" style="display:flex;gap:8px;align-items:center;width:100%">
                                    <input type="hidden" name="productId" value="<%= product._id %>">
                                    <input type="number" name="qty" value="1" min="1" max="<%= product.stock %>" style="width:70px;padding:8px;border:1px solid #ddd;border-radius:6px;font-size:0.95rem">
                                    <button class="btn btn-primary btn-small" type="submit" <%= product.stock === 0 ? 'disabled' : '' %> style="flex:1">Order Now</button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="products-grid">
                <div class="no-products">
                    <h2>No products found</h2>
                    <p>Check back soon for new arrivals in this collection.</p>
                </div>
            </div>
        <% } %>

        <% if (totalPages > 1) { %>
            <div class="pagination">
                <% if (currentPage > 1) { %>
                    <a href="<%= baseUrl %>?page=<%= currentPage - 1 %>">← Previous</a>
                <% } else { %>
                    <span class="disabled">← Previous</span>
                <% } %>

                <% let startPage = Math.max(1, currentPage - 2); %>
                <% let endPage = Math.min(totalPages, currentPage + 2); %>
                <% if (startPage > 1) { %>
                    <a href="<%= baseUrl %>?page=1">1</a>
                    <% if (startPage > 2) { %>
                        <span>...</span>
                    <% } %>
                <% } %>

                <% for (let i = startPage; i <= endPage; i++) { %>
                    <% if (i === currentPage) { %>
                        <span class="active"><%= i %></span>
                    <% } else { %>
                        <a href="<%= baseUrl %>?page=<%= i %>"><%= i %></a>
                    <% } %>
                <% } %>

                <% if (endPage < totalPages) { %>
                    <% if (endPage < totalPages - 1) { %>
                        <span>...</span>
                    <% } %>
                    <a href="<%= baseUrl %>?page=<%= totalPages %>"><%= totalPages %></a>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <a href="<%= baseUrl %>?page=<%= currentPage + 1 %>">Next →</a>
                <% } else { %>
                    <span class="disabled">Next →</span>
                <% } %>
            </div>
        <% } %>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>
