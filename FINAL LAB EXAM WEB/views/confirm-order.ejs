<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Confirm Order - Sania Maskatiya Store</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Montserrat', sans-serif; background-color: #f7f7f7; color: #333; }
    .top-bar { background: #8b4789; color: white; text-align: center; padding: 10px; font-size: 0.9rem; }
    .page-header { padding: 30px 20px; text-align: center; background: white; box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-bottom: 30px; }
    .page-header h1 { font-size: 2rem; color: #8b4789; margin: 0; }
    .container { max-width: 800px; margin: 0 auto; padding: 20px; }
    .confirm-card { background: white; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.1); overflow: hidden; }
    .product-section { padding: 30px; display: flex; gap: 30px; align-items: flex-start; border-bottom: 2px solid #f0f0f0; }
    .product-image { width: 180px; height: 200px; object-fit: cover; border-radius: 10px; }
    .product-details { flex: 1; }
    .product-details h2 { font-size: 1.8rem; color: #333; margin: 0 0 12px 0; }
    .product-category { font-size: 0.85rem; color: #8b4789; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
    .detail-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #f0f0f0; }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { color: #666; font-weight: 600; }
    .detail-value { font-weight: 700; color: #333; }
    .summary-section { padding: 30px; background: #f9f7f4; }
    .summary-row { display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 1.05rem; }
    .summary-row.total { border-top: 2px solid #8b4789; padding-top: 12px; font-size: 1.3rem; font-weight: 700; color: #8b4789; }
    .payment-section { padding: 20px 30px; background: #f0f7f4; border-left: 4px solid #27ae60; }
    .payment-section strong { color: #27ae60; }
    .buttons-section { padding: 30px; display: flex; gap: 12px; justify-content: center; }
    .btn { padding: 12px 28px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 1rem; text-decoration: none; transition: all 0.3s; }
    .btn-primary { background: #8b4789; color: white; }
    .btn-primary:hover { background: #6d5845; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(139, 71, 137, 0.3); }
    .btn-secondary { background: #ddd; color: #333; }
    .btn-secondary:hover { background: #bbb; }
  </style>
</head>
<body>
  <div class="top-bar">CONFIRM YOUR ORDER - CASH ON DELIVERY</div>

  <header class="main-header">
    <div class="logo"><img src="/images/logo.svg" alt="Sania Maskatiya"></div>
    <button class="hamburger-menu" id="hamburgerMenu">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav-menu" id="navMenu">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/shop-by">Shop</a></li>
        <li><a href="/profile">Profile</a></li>
        <li><a href="/orders">My Orders</a></li>
      </ul>
    </nav>
  </header>

  <div class="page-header">
    <h1>Order Confirmation</h1>
  </div>

  <div class="container">
    <div class="confirm-card">
      <div class="product-section">
        <img src="<%= product.image %>" alt="<%= product.name %>" class="product-image">
        <div class="product-details">
          <div class="product-category"><%= product.category %></div>
          <h2><%= product.name %></h2>
          <div class="detail-row">
            <span class="detail-label">Unit Price:</span>
            <span class="detail-value">Rs. <%= product.price.toLocaleString() %></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Quantity:</span>
            <span class="detail-value"><%= qty %> piece(s)</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Subtotal:</span>
            <span class="detail-value">Rs. <%= (product.price * qty).toLocaleString() %></span>
          </div>
        </div>
      </div>

      <div class="summary-section">
        <div class="summary-row">
          <span>Subtotal:</span>
          <span>Rs. <%= (product.price * qty).toLocaleString() %></span>
        </div>
        <div class="summary-row">
          <span>Shipping:</span>
          <span>FREE</span>
        </div>
        <div class="summary-row total">
          <span>Total Amount:</span>
          <span>Rs. <%= (product.price * qty).toLocaleString() %></span>
        </div>
      </div>

      <div class="payment-section">
        <strong>💳 Payment Method: Cash on Delivery (COD)</strong>
        <p>Pay when you receive your order at your doorstep.</p>
      </div>

      <div class="buttons-section">
        <form method="post" action="/orders/confirm" style="display: flex; gap: 12px;">
          <input type="hidden" name="productId" value="<%= product._id %>">
          <input type="hidden" name="qty" value="<%= qty %>">
          <button type="submit" class="btn btn-primary">✓ Confirm Order</button>
        </form>
        <a href="/shop-by" class="btn btn-secondary">← Continue Shopping</a>
      </div>
    </div>
  </div>

  <script src="/js/script.js"></script>
</body>
</html>
